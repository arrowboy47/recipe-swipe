MEALIE_URL=http://your-mealie-host:9925
MEALIE_TOKEN=your-mealie-api-token
SWIPE_AUTH_USER=your-username
SWIPE_AUTH_PASS=pick-a-strong-password

# Set to 1 on any instance that is not your real one. Swipes still file the
# staged record, but nothing is written to Mealie, and the UI shows a "Dry run"
# badge. Without it, a test swipe-right imports into your real recipe library.
SWIPE_DRY_RUN=0
